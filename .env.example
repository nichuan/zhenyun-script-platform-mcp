SCRIPT_PLATFORM_BASE_URL=https://gateway.dev.example.com
# 插件打包运行时可指向本项目保存 .env 的目录。
SCRIPT_PLATFORM_ENV_DIR=
# 自动认证：如果配置账号密码，优先使用这里的值；.env 不要提交 Git，建议限制为仅本人可读。
SCRIPT_PLATFORM_SSO_USERNAME=
SCRIPT_PLATFORM_SSO_PASSWORD=
# 未配置密码时，依次回退到 0600 私有凭据文件，再回退到 macOS Keychain。
SCRIPT_PLATFORM_ACCOUNT_FILE=.auth/account.json
# 无人值守推荐：CLI 创建的 chmod 600 私有凭据文件；不要提交 Git。
SCRIPT_PLATFORM_SSO_CREDENTIAL_FILE=.auth/credentials.json
SCRIPT_PLATFORM_KEYCHAIN_SERVICE=zhenyun-script-platform-sso
SCRIPT_PLATFORM_TOKEN_FILE=.auth/token.json
# 可选：兼容读取其它登录流程生成的 token.json/keycloak.json，逗号分隔且必须 chmod 600。
SCRIPT_PLATFORM_TOKEN_FILES=
# bearer => Authorization: Bearer <token>；raw => Authorization: <token>
SCRIPT_PLATFORM_AUTHORIZATION_SCHEME=bearer
# 以下 SSO 参数通常无需修改。
SCRIPT_PLATFORM_CLIENT_ID=srm-dev
SCRIPT_PLATFORM_TOKEN_URL=https://sso.going-link.com/auth/realms/going-link/protocol/openid-connect/token
SCRIPT_PLATFORM_AUTHORIZE_URL=https://sso.going-link.com/auth/realms/going-link/protocol/openid-connect/auth
SCRIPT_PLATFORM_REDIRECT_URI=https://zhenyun.dev.isrm.going-link.com/oauth/login/bykey?nonce=platform
SCRIPT_PLATFORM_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
SCRIPT_PLATFORM_CHROME_PROFILE_DIR=.auth/chrome-profile
SCRIPT_PLATFORM_AUTH_HEADLESS=true
SCRIPT_PLATFORM_TOKEN_REFRESH_SKEW_SECONDS=120
# 所有写操作都必须经过两次调用和人工确认；凭证默认十分钟失效且只能使用一次。
SCRIPT_PLATFORM_CONFIRM_TTL_SECONDS=600
SCRIPT_PLATFORM_COOKIE=
SCRIPT_PLATFORM_MENU_ID=
SCRIPT_PLATFORM_TIMEOUT=30
SCRIPT_PLATFORM_VERIFY_SSL=true
SCRIPT_PLATFORM_DEFAULT_PAGE_SIZE=20
SCRIPT_PLATFORM_MAX_PAGE_SIZE=100
SCRIPT_PLATFORM_TEXT_PREVIEW_CHARS=500
